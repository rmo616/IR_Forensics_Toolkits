alert tcp any any -> any 80 (msg:"HTTP Traffic Detected on Port 80"; sid:1000002; rev;)

alert tcp any any -> any 80 (msg:"Suspicious Admin Portal Access Attempt"; http_uri; content:"/admin"; nocase; sid:1000003; rev;)

alert tcp any any -> any any (msg:"NMAP TCP SYN Scan Detected"; flags:S; threshold:type threshold, track by_src, count 20, seconds 5; sid:1000001; rev;)

alert icmp any any -> any any (msg:"TEST ICMP Ping Detected"; sid:1000001; rev;)

snort -c /usr/local/etc/snort/snort.lua -i enp0s8 -A alert_fast

