'''create a db account with a unique password'''
CREATE USER 'ingestion_user'@'localhost' IDENTIFIED BY 'unique_password';

'''grant all privileges to the user'''
GRANT ALL PRIVILEGES ON *.* TO 'ingestion_user'@'localhost';

'''grant all privileges on the database to the user'''
GRANT ALL PRIVILEGES ON your_database_name.* TO 'ingestion_user'@'localhost';

'''table crearted'''
CREATE TABLE Ingested_Data (
    IOC_Type VARCHAR(36),
    IOC_Value VARCHAR(50),
    Date_Detected DATETIME DEFAULT CURRENT_TIMESTAMP,
    Descript VARCHAR(100),
    Severity_Level VARCHAR(100),
    Malware_Category VARCHAR(100),
    Offense_Count INT 
);

